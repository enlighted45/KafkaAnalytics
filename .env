# Shared KRaft cluster id (any base64 UUID; generate with: docker run --rm apache/kafka:4.4.0 /opt/kafka/bin/kafka-storage.sh random-uuid)
KAFKA_CLUSTER_ID=vElOEmyBS2aYkCQrH2jzDw
KAFKA_IMAGE=apache/kafka:4.4.0
KAFKA_HEAP=-Xms512m -Xmx512m
DASHBOARD_PORT=3000
KAFKA_UI_PORT=8080
PRODUCER_PORT=8081
ANALYTICS_PORT=8090
# Generator defaults
GENERATOR_RATE=50
GENERATOR_AUTOSTART=true
